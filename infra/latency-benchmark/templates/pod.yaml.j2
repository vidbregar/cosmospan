apiVersion: v1
kind: Pod
metadata:
  name: ping-pod-{{ node_ip_clean }}
  namespace: {{ benchmark_namespace }}
  labels:
    app: ping-pod-{{ node_ip_clean }}
spec:
  nodeName: {{ node_name }}
  containers:
  - name: nginx
    image: nginx:1.25-alpine
    # The base image's default command starts Nginx.
    # We will exec into the container to install and use curl.
    resources:
      limits:
        cpu: 100m
        memory: 128Mi
      requests:
        cpu: 50m
        memory: 64Mi
